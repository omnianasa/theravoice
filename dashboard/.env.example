# Public frontend setting only. Never put service keys, provider credentials,
# patient data, or other secrets in VITE_* variables.
#
# Leave blank for the Vite development proxy and for a same-origin FastAPI
# deployment. Set an absolute HTTPS API origin for a separately hosted API.
VITE_API_BASE_URL=

# FastAPI serves the compiled dashboard from /dashboard/ by default.
# Set "/" when building for a static host that serves the app at its root.
VITE_BASE_PATH=/dashboard/
